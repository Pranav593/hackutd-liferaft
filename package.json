{
  "name": "liferaft-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.170.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.170.0"
  },
  "scripts": {
    "dev": "next dev web --hostname 127.0.0.1",
    "build": "next build web",
    "start": "next start web --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:contracts": "tsc --noEmit -p web/tsconfig.fixtures.json"
  }
}
