LIFERAFT_STATE_DIR=.liferaft
# Local operator token is optional for single-user development.
LIFERAFT_OPERATOR_TOKEN=
# Each laptop gets the public HTTPS origin and only its own role token.
LIFERAFT_CLOUD_URL=
LIFERAFT_CLOUD_TOKEN=
# The Atlas URI and server-side tokens belong in Render's Environment tab.
# The optional LIFERAFT_GATEWAY_TOKEN matches the bridge's local .env.gateway token.
# Server only. Never put these values in browser or device firmware.
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# Optional Pi token is configured on the coordinator; the Pi uses .env.pi_primary.
# LIFERAFT_PI_PRIMARY_TOKEN=
# Photon coordinator-only webhook configuration. Keep the API key in .env.photon on the runner.
# LIFERAFT_ENABLE_PHOTON=0
# LIFERAFT_PHOTON_TOKEN=
# PHOTON_JOB=
# PHOTON_SPACE_ID=
# PHOTON_OPERATOR_USER_ID=
# PHOTON_AGENT_USER_ID=
# PHOTON_WEBHOOK_SECRET=

# Hosted coordinator opt-in for the live cockpit. Requires LIFERAFT_ENABLE_DRILLS=1.
# LIFERAFT_ENABLE_LIVE_DEMO=1
# Set PHOTON_JOB=live-demo-control on Render to follow the current live demo.
